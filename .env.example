# TechPulse server configuration
DATABASE_URL=

# Optional public GitHub profile fallback (used when OAuth is not connected)
GITHUB_USERNAME=
GITHUB_TOKEN=

# Optional GitHub OAuth (the app falls back to demo mode until configured)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/github/callback
APP_URL=http://localhost:5000

# Required for server-side AI repository analysis
GEMINI_API_KEY=